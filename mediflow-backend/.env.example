# Copy to .env for local development. On Vercel, set these as Environment
# Variables in the project settings instead.

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGO_URI=

# Secret used to sign auth tokens. Required. Use a long random string.
JWT_SECRET=

# Token lifetime, e.g. 7d, 24h, 3600. Required.
JWT_EXPIRES_IN=7d

# Local dev only — Vercel sets the port itself.
PORT=3000

# Optional: override the shared read-only demo account.
# DEMO_EMAIL=demo@mediflow.com
# DEMO_PASSWORD=demo1234
# DEMO_NAME=Demo User
