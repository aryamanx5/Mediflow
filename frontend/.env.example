# ─── Production ───────────────────────────────────────────────────────────
# Base URL of the deployed backend API, including the /api suffix. Consumed by
# src/services/client.ts as `import.meta.env.VITE_API_URL`. A committed default
# lives in .env.production; on Vercel set this as a Project Environment Variable.
#
#   VITE_API_URL=https://mediflow-backend-eight.vercel.app/api
#
# It is NOT a secret. Never put MONGO_URI, JWT_SECRET or any backend value here —
# every VITE_-prefixed var is embedded in the public bundle.

# ─── Local development only ───────────────────────────────────────────────
# With VITE_API_URL unset, the app calls "/api" on its own origin and the Vite
# dev server proxies that to the backend below (see vite.config.ts).
# VITE_API_TARGET=http://127.0.0.1:3000
